<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#0F172A</item>
        <item name="colorPrimaryDark">#0F172A</item>
        <item name="colorAccent">#38BDF8</item>
    </style>

    <!--
        Runtime theme: draws the WebView edge-to-edge behind the status bar and
        navigation bar so CSS env(safe-area-inset-*) variables receive the correct
        inset values and the system bars match StockFlow's design.
        - windowDrawsSystemBarBackgrounds: lets the app paint behind the bars.
        - statusBarColor / navigationBarColor: transparent so the WebView
          content shows through; the HTML/CSS already handles inset padding.
        - windowLightStatusBar: false → white status-bar icons (needed on the
          dark #0F172A header used by StockFlow's mobile top bar).
        - windowLayoutInDisplayCutoutMode: shortEdges → honors viewport-fit=cover
          on notched/punch-hole devices.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>